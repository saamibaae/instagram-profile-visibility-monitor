# ==============================================================
# Instagram Profile Visibility Monitor — Environment Configuration
# ==============================================================

# Target Instagram handle to monitor (without @)
TARGET_USERNAME=instagram

# Schedule mode: FIXED (3 to 60 minutes) or RANDOM_RANGE (60 to 180 seconds)
SCHEDULE_MODE=FIXED

# Fixed interval in minutes (used when SCHEDULE_MODE=FIXED)
FIXED_INTERVAL_MINUTES=3

# Random interval bounds in seconds (used when SCHEDULE_MODE=RANDOM_RANGE)
RANDOM_MIN_SECONDS=60
RANDOM_MAX_SECONDS=180

# Dashboard authentication & Reverse proxy security
DASHBOARD_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1

# Residential / Datacenter Proxy (Optional, for datacenter IP unblocking)
# Format: http://user:pass@host:port or socks5://host:port
PROXY_URL=

# Telegram transition alert notifications & Two-way bot
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TWO_WAY_ENABLED=true
CONSECUTIVE_UNKNOWN_ALERT_THRESHOLD=5

# Browser execution options
HEADLESS=true
EPHEMERAL_BROWSER=true
FAST_PATH=true
BATTERY_SAVER=false

# Server port and environment
PORT=3847
NODE_ENV=production
